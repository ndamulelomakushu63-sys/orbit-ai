{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/api/payfast/checkout", "dest": "/api/payfast/checkout" },
    { "src": "/api/payfast/notify", "dest": "/api/payfast/notify" },
    { "src": "/api/market/checkout-init", "dest": "/api/market/checkout-init" },
    { "src": "/api/market/products(.*)", "dest": "/api/market/catalog?resource=products" },
    { "src": "/api/market/brands(.*)", "dest": "/api/market/catalog?resource=brands" },
    { "src": "/api/rewards/quiz(.*)", "dest": "/api/rewards?mode=quiz" },
    { "src": "/api/rewards/redeem(.*)", "dest": "/api/rewards?mode=redeem" },
    { "src": "/api/rewards/(.*)", "dest": "/api/rewards" },
    { "src": "/api/debug-openai(.*)", "dest": "/api/chat?action=debug" },
    { "handle": "filesystem" },
    { "src": "/admin/(.*)", "dest": "/admin/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
